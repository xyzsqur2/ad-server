# Ad-Server Environment Configuration

# Port
PORT=3002

# Node Environment
NODE_ENV=production

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account-key.json

# Dashboard Activation Token - Protege o endpoint POST /api/activation-keys
DASHBOARD_ACTIVATION_TOKEN=C@rlaoonumero1nolongerP@ss

# CORS - Permite apenas estas origens (separadas por vírgula)
# ALLOWED_ORIGINS=https://seu-app.com,https://app.seu-app.com

# Admin Token - Para operações admin (migração de geolocalização)
# ADMIN_TOKEN=seu-token-admin-aqui

# PAK Key - Chave AES-256 do assets.pak.enc (64 hex chars = 32 bytes)
# Gerada pelo script: npm run pak:embed (saída no console)
# NUNCA commitar esse valor — adicionar apenas nas env vars do Render
PAK_AES_KEY_HEX=COLE_AQUI_A_CHAVE_GERADA_PELO_SCRIPT
